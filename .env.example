# Frontend (Vite) environment — copy to .env.local for local dev.
# ONLY the anon key belongs here. NEVER put the service_role key or DB password
# in the frontend env (they would ship to the browser).
#
# Local dev: point at Docker Supabase (e.g. http://127.0.0.1:54321).
# Production (Vercel): point at your hosted Supabase project.

VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-public-key>
VITE_VAPID_PUBLIC_KEY=<your-vapid-public-key>
